# Copy to .env and fill in. .env is git-ignored; .env.example is not.

# DocRaptor turns the issue HTML into a print-ready PDF.
# Get a key at https://docraptor.com/ .
#
# Test-mode calls are FREE but stamp a proof watermark across every page, so a
# test-mode PDF can never go to a printer. Test mode is the default. Passing
# --live to the generator produces a clean file and IS BILLED.
#
# NOTE: the key previously hardcoded in this repo was committed publicly and
# should be treated as compromised. Rotate it before use.
DOCRAPTOR_API_KEY=

# Stripe, for the web edition's subscription and advertising checkout.
VITE_STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
